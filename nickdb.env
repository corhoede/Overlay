; P2_NICKDB_TABLE=pika_bedwars_monthly_wins
; P2_NICKDB_UUID_COLUMN=offline_uuid
; P2_NICKDB_NAME_COLUMN=player_name
; P2_NICKDB_QUERY_TEMPLATE=SELECT player_name FROM pika_bedwars_monthly_wins WHERE REPLACE(LOWER(offline_uuid), '-', '') = '{uuid_nodash}' LIMIT 1
P2_RESOLVER_SHARED_SECRET=c8509f4ad1e44e7113dffd17326874cffce5ef6f6981511c8b9006da5ff11e01
