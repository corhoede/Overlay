P2_NICKDB_ENABLE=1
P2_NICK_RESOLVE_URL=http://127.0.0.1:8787/resolve/{uuid_nodash}
P2_NICKDB_ODBC_FALLBACK=0
P2_ONLINE_UUID_FIX_ENABLE=1
